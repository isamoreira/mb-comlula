{
  "name": "espalha-hoje",
  "version": "1.0.0",
  "private": true,
  "description": "Espalha Hoje: os 3 conteúdos do dia, prontos para compartilhar.",
  "scripts": {
    "build": "node build.js",
    "dev": "node dev.js",
    "start": "node build.js && node dev.js",
    "importar": "node scripts/importar.js",
    "novo-post": "node scripts/novo-post.js",
    "otimizar": "node scripts/otimizar.js",
    "pacote": "node build.js && node scripts/pacote.js",
    "conferir": "node build.js && node scripts/conferir.js",
    "exemplos": "node scripts/gerar-exemplos.js",
    "test": "node build.js --exemplo && node test/smoke.js",
    "test:e2e": "node build.js --exemplo && node test/e2e.js",
    "test:contador": "node test/contador.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "sharp": "^0.34.0"
  },
  "devDependencies": {
    "puppeteer-core": "^24.0.0"
  }
}
